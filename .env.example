# Copy to .env for LOCAL development only. Never commit real credentials.
# In production, define these variables in the hosting panel (or a .env kept OUTSIDE the webroot).

# --- Application (new architecture: app/, config/) ---
APP_ENV=local            # local | development | testing | staging | production (debug only allowed in local/development/testing)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guayaquil

# --- Database (new architecture: App\Database\Connection) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lawfirm
DB_USERNAME=lawfirm_user
DB_PASSWORD=change-me

# --- Security (used from Phase 2) ---
SESSION_SECURE_COOKIE=false   # true when served over HTTPS
SESSION_SAME_SITE=Lax

# --- LEGACY (still read by db.php, backend/db.php and the Node scripts) ---
# Keep them equal to the DB_* values until the legacy connection files are retired.
# The new configuration accepts them as fallback when DB_* are not defined.
MYSQL_HOST=127.0.0.1
MYSQL_USER=lawfirm_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=lawfirm
PORT=3000
